# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars should be gitignored -- do not commit real project IDs
# if you consider them sensitive, and NEVER commit credentials/secrets here.

project_id = "your-gcp-project-id"
region     = "asia-south2"

pubsub_topic_name        = "cloud-siem-events"
pubsub_subscription_name = "cloud-siem-events-sub"
log_sink_name             = "siem-audit-log-sink"
cloud_run_service_name    = "log-normalizer"
